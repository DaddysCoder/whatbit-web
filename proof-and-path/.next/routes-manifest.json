{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/export/[caseId]",
      "regex": "^/api/export/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPcaseId": "nxtPcaseId"
      },
      "namedRegex": "^/api/export/(?<nxtPcaseId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/cases/[id]",
      "regex": "^/cases/([^/]+?)(?:/)?$",
