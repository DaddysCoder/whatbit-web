{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@/components/layout/*": ["./proof-and-path/components/layout/*"],
      "@/components/ui": ["./proof-and-path/components/ui/index.ts"],
      "@/components/ui/*": ["./proof-and-path/components/ui/*"],
      "@/components/providers": ["./proof-and-path/components/providers/index.ts"],
      "@/components/providers/*": ["./proof-and-path/components/providers/*"],
      "@/components/screens/*": ["./proof-and-path/components/screens/*"],
      "@/components/shared/*": ["./proof-and-path/components/shared/*"],
      "@/lib/constants/*": ["./proof-and-path/lib/constants/*"],
      "@/lib/hooks/*": ["./proof-and-path/lib/hooks/*"],
      "@/lib/types": ["./proof-and-path/lib/types/index.ts"],
      "@/lib/types/*": ["./proof-and-path/lib/types/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules", "proof-and-path/node_modules"]
}
